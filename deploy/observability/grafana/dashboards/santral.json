      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (sum(rate(santral_http_requests_total{status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(santral_http_requests_total[5m])), 1e-9)",
